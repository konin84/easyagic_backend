# Copy this file to .env and fill in your values
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Neon PostgreSQL — get your connection string from https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Google Gemini — get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Vision model for soil analysis. Pinned by default; set to gemini-flash-latest
# to always track the newest Flash release.
GEMINI_MODEL=gemini-3.6-flash

# Google Cloud Translation API — enable at https://console.cloud.google.com
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# Default admin account created automatically on first migrate
DJANGO_SUPERUSER_EMAIL=admin@easyagric.com
DJANGO_SUPERUSER_PASSWORD=change-me-immediately
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=EasyAgric

# Subscriptions — free trial granted at registration
TRIAL_DAYS=14
TRIAL_ANALYSIS_QUOTA=5
# Fallback currency; per-plan prices and bank details are managed in Django admin
DEFAULT_CURRENCY=XOF

# Initial prices + bank details, seeded on deploy by `manage.py seed_payment_config`.
# Single-line JSON — see payment_config.example.json for the full shape.
# Existing rows are left untouched, so editing prices in Django admin wins.
PAYMENT_CONFIG_JSON={"prices":[{"plan":"pro","currency":"XOF","amount":15000}],"accounts":[{"currency":"XOF","bank_name":"...","account_name":"...","account_number":"..."}]}

# JWT lifetimes. Access tokens cannot be revoked before they expire, so a longer
# access window means a deactivated or deleted account keeps working until it lapses.
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=7
